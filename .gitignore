# --- Build output ---
Build/*
!Build/.gitkeep
*.xex
*.elf
*.obj
*.pdb
*.ilk
*.map
*.log

# --- Visual Studio ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
ipch/
Debug/
Release/
x64/
x86/

# --- Xbox 360 XDK ---
*.xdk
*.xdb
*.xbx

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp

# --- Large archives (host in Releases, not the repo) ---
*.7z
*.zip
*.rar

# --- Environment ---
.env
.env.local

# --- Keep .gitkeep everywhere ---
!.gitkeep
